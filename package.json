{
  "name": "piloto-streaming",
  "version": "2.0.0",
  "private": true,
  "description": "Plataforma de streaming v2.0 estilo Netflix/Cuevana Pro con Catálogo Masivo Híbrido TMDB, Auto-Resolver de Mirrors, TokenCryptoService (AES-256-GCM) y Health Checker.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "health-check": "tsx --env-file=.env scripts/health-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.454.0",
    "next": "14.2.16",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
