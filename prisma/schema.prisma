generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  SERIES
}

enum MirrorFormat {
  MP4
  HLS
  EMBED
}

enum MirrorStatus {
  ACTIVE
  UNDER_REVIEW
  DOWN
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String?
  avatarUrl    String?
  googleId     String?        @unique
  lastLoginAt  DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  watchHistory WatchHistory[]
}

model Movie {
  id            String         @id @default(uuid())
  tmdbId        Int?           @unique
  mediaType     MediaType      @default(MOVIE)
  title         String
  originalTitle String?
  synopsis      String         @db.Text
  posterUrl     String
  backdropUrl   String?
  releaseYear   Int
  durationMins  Int            @default(120)
  rating        Float          @default(7.0)
  qualityBadge  String         @default("HD")
  genres        String[]       @default([])
  isAvailable   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  mirrors       MirrorLink[]
  watchHistory  WatchHistory[]
  seasons       Season[]

  @@index([isAvailable])
  @@index([title])
  @@index([mediaType])
}

model Season {
  id           String    @id @default(uuid())
  seriesId     String
  seasonNumber Int
  title        String
  overview     String?   @db.Text
  posterUrl    String?
  releaseDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  series       Movie     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([seriesId, seasonNumber])
  @@index([seriesId])
}

model Episode {
  id            String          @id @default(uuid())
  seasonId      String
  episodeNumber Int
  title         String
  overview      String?         @db.Text
  duration      Int             @default(45)
  videoUrl      String          @default("") @db.Text
  thumbnailUrl  String?
  introStart    Int?
  introEnd      Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  season        Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory  WatchHistory[]
  mirrors       EpisodeMirror[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
}

model EpisodeMirror {
  id                  String       @id @default(uuid())
  episodeId           String
  serverName          String
  language            String       @default("Latino")
  rawUrl              String       @db.Text
  format              MirrorFormat @default(MP4)
  quality             String       @default("1080p")
  priority            Int          @default(1)
  status              MirrorStatus @default(ACTIVE)
  consecutiveFailures Int          @default(0)
  lastCheckedAt       DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  episode             Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, status, priority])
  @@index([status])
}

model MirrorLink {
  id                  String       @id @default(uuid())
  movieId             String
  serverName          String
  language            String       @default("Latino")
  rawUrl              String       @db.Text
  format              MirrorFormat @default(MP4)
  quality             String       @default("1080p")
  priority            Int          @default(1)
  status              MirrorStatus @default(ACTIVE)
  consecutiveFailures Int          @default(0)
  lastCheckedAt       DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  movie               Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId, status, priority])
  @@index([status])
}

model WatchHistory {
  id              String   @id @default(uuid())
  userId          String
  movieId         String?
  episodeId       String?
  progressSeconds Int      @default(0)
  durationSeconds Int      @default(7200)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie           Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, episodeId])
  @@index([userId, updatedAt])
  @@index([movieId])
  @@index([episodeId])
}
